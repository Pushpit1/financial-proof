{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "backend/frontend/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.py"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/index.py": {
      "excludeFiles": "backend/tests/**"
    }
  }
}
