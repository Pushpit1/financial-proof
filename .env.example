# ============================================================
# FINANCIAL PROOF
# Environment Template
# ============================================================

# -------------------------
# Application
# -------------------------
APP_NAME=Financial Proof
APP_ENV=development
APP_VERSION=0.1.0
DEBUG=true

# -------------------------
# API
# -------------------------
API_HOST=0.0.0.0
API_PORT=8000

# -------------------------
# Database
# -------------------------
DATABASE_URL=postgresql+psycopg://financial_proof:financial_proof@localhost:5432/financial_proof

# -------------------------
# Redis
# -------------------------
REDIS_URL=redis://localhost:6379/0

# -------------------------
# Razorpay
# Test Mode credentials only
# -------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# -------------------------
# AI
# -------------------------
LLM_API_KEY=
LLM_MODEL=

# -------------------------
# Security
# -------------------------
SECRET_KEY=change-me-in-development