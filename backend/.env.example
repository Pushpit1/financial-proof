# Financial Proof environment configuration example.
#
# Copy this file to .env for local development.
# Never commit real secrets.

APP_NAME=Financial Proof API
APP_VERSION=0.1.0
APP_ENV=development
DEBUG=false

API_HOST=0.0.0.0
API_PORT=8000

DATABASE_URL=sqlite:///./financial_proof.db

API_AUTH_TOKEN=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

PROOF_MINIMUM_REVIEW_CONFIDENCE=0.00
PROOF_MINIMUM_READY_CONFIDENCE=0.70
PROOF_MINIMUM_SUPPORTED_CLAIM_RATIO=1.00
